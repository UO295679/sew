<?xml version="1.0" encoding="UTF-8"?>
<kml xmlns="http://www.opengis.net/kml/2.2">
  <Document>
    <name>Carrefour Granada a Granada</name>

    <!-- Estilo para la línea del recorrido -->
    <Style id="redLine">
      <LineStyle>
        <color>ff0000ff</color>
        <width>4</width>
      </LineStyle>
    </Style>

    <!-- Estilo Rojo: Salida y Meta -->
    <Style id="redPin">
      <IconStyle>
        <color>ff0000ff</color>
        <scale>1.1</scale>
        <Icon>
          <href>http://maps.google.com/mapfiles/kml/pushpin/red-pushpin.png</href>
        </Icon>
      </IconStyle>
    </Style>

    <!-- Estilo Verde: Puertos de Montaña -->
    <Style id="greenPin">
      <IconStyle>
        <color>ff008000</color>
        <scale>1.1</scale>
        <Icon>
          <href>http://maps.google.com/mapfiles/kml/pushpin/grn-pushpin.png</href>
        </Icon>
      </IconStyle>
    </Style>

    <!-- Estilo Azul: Sprints Intermedios -->
    <Style id="bluePin">
      <IconStyle>
        <color>ffff0000</color>
        <scale>1.1</scale>
        <Icon>
          <href>http://maps.google.com/mapfiles/kml/pushpin/blue-pushpin.png</href>
        </Icon>
      </IconStyle>
    </Style>

    <!-- Estilo Amarillo: Puntos con Kilometraje -->
    <Style id="yellowPin">
